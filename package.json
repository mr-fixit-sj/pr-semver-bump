{
  "name": "pr-semver-bump",
  "version": "1.0.0",
  "description": "A GitHub Action to bump and tag a new semantic version when a pull request is merged.",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "prepare": "ncc build index.js -o dist --source-map",
    "test": "jest --coverage",
    "all": "npm run lint && npm run prepare && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-fixit-sj/pr-semver-bump.git"
  },
  "keywords": [
    "GitHub",
    "Actions",
    "pull",
    "request",
    "PR",
    "semver",
    "bump",
    "release",
    "tag",
    "notes"
  ],
  "author": "Jeff Linse",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "bugs": {
    "url": "https://github.com/mr-fixit-sj/pr-semver-bump/issues"
  },
  "homepage": "https://github.com/mr-fixit-sj/pr-semver-bump#readme",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "semver": "^7.8.5"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.45.0",
    "eslint": "^7.32.0",
    "eslint-config-airbnb-base": "^14.2.1",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.5.2"
  }
}
